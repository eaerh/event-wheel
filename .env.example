# Copy this file to .env and fill in your values.
# The backend reads DATABASE_URL on startup.

# ── Shared Neon PostgreSQL database ──────────────────────────────────────────
# Get your connection string from https://neon.tech (free account, no card needed)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Public URL for poll share links (local tunnel only) ───────────────────────
# Only needed when sharing polls while running locally via a tunnel.
# On Render this is set automatically via RENDER_EXTERNAL_URL.
# PUBLIC_URL=https://your-tunnel-url.ngrok.io
